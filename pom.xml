<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    modelVersion>4.0.0</modelVersion>

    <groupId>org.yccheok</groupId>
    <artifactId>jstock</artifactId>
    <version>1.0.7-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>JStock</name>
    <description>Free stock market software for 27 countries</description>

    <properties>
        <maven.compiler.source>1.8</maven.compiler.source>
        <maven.compiler.target>1.8</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!-- JUnit Test Framework -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        <!-- Vendored libraries under libs/ -->
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>swingx</artifactId>
            <version>0.9.6</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/swingx/swingx-0.9.6.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>swing-layout</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/swing-layout-1.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>jxlayer</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/jxlayer/jxlayer.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>l2fprod-common-all</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/l2fprod-common-all.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>jh</artifactId>
            <version>1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/jh.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>gson</artifactId>
            <version>2.2.4</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/google-gson-2.2.4/gson-2.2.4.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>xstream</artifactId>
            <version>1.4.2</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/xstream/xstream-1.4.2.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>poi</artifactId>
            <version>3.2</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/poi-3.2-FINAL/poi-3.2-FINAL-20081019.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>ta-lib</artifactId>
            <version>0.4.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/TA-Lib/ta-lib-0.4.0.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>commons-httpclient</artifactId>
            <version>3.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/commons-httpclient-3.1-rc1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>commons-lang</artifactId>
            <version>2.4</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/commons-lang-2.4/commons-lang-2.4.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>commons-logging</artifactId>
            <version>1.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/commons-logging-1.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>commons-net</artifactId>
            <version>1.4.1</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/commons-net-1.4.1.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>commons-codec</artifactId>
            <version>1.3</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/commons-codec-1.3.jar</systemPath>
        </dependency>
        <dependency>
            <groupId>org.yccheok.jstock.libs</groupId>
            <artifactId>forms</artifactId>
            <version>1.1.0</version>
            <scope>system</scope>
            <systemPath>${project.basedir}/libs/forms-1.1.0.jar</systemPath>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src</sourceDirectory>
        <testSourceDirectory>test</testSourceDirectory>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.8.1</version>
                <configuration>
                    <source>1.8</source>
                    <target>1.8</target>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>2.22.2</version>
            </plugin>
        </plugins>
    </build>
</project>
